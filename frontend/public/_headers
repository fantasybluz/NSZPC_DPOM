# 前端靜態檔案的安全標頭（Cloudflare Workers Static Assets 會讀這個檔案；API 的標頭在 src/worker.ts）
# CSP 要開放的：
#   - 'unsafe-inline' script：Next.js 靜態輸出的頁面裡有內嵌的 <script>
#   - cdn.jsdelivr.net：盤商報價的 OCR（tesseract.js）從這裡載入 worker、wasm 和中文字庫；blob: 是它建的 Web Worker
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; worker-src 'self' blob: https://cdn.jsdelivr.net; connect-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
