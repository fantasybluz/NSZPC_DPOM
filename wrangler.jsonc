{
  // 星辰電腦 NSZPC 管理系統：一個 Cloudflare Worker。前端（frontend/out，Next.js 靜態輸出）當靜態檔案，/api 交給 src/worker.ts
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nszpc-dpom",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  // VERSION 當成文字打包進 Worker（/api/version 用；版號只寫在 VERSION 一個地方）
  "rules": [{ "type": "Text", "globs": ["**/VERSION"], "fallthrough": true }],
  "assets": {
    "directory": "frontend/out",
    // Next.js 靜態輸出是 dashboard.html 這種檔名，/dashboard 會自動對到
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // 整個網站都在 Cloudflare Access 後面（內部系統），客戶確認後可以換成自己的網域
  "routes": [{ "pattern": "dpom.bluz.dev", "custom_domain": true }],
  // 只留正式網址：workers.dev 和預覽網址前面沒有 Cloudflare Access
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ACCESS_TEAM_DOMAIN": "old-fog-9482.cloudflareaccess.com",
    // Access 應用的 Application Audience (AUD) Tag；沒設的話 API 一律拒絕
    "ACCESS_AUD": "0566db847df16640336db9562eab86d59189896ccdd085712f69a589ba689dc8",
    // 第一次登入時自動建成管理員的 email（之後由管理員在「使用者管理」加人）
    "BOOTSTRAP_ADMIN_EMAILS": "fantasybluz@gmail.com,bluzstudio2020@gmail.com",
    // 官網網址（發布後給連結用；客戶換網域時改這裡）
    "WEBSITE_URL": "https://nszpc.bluz.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nszpc-dpom",
      "database_id": "9da215ba-329c-4ac9-9f01-945558f28595",
      "migrations_dir": "migrations"
    }
  ],
  // 官網（NSZ_PC，Worker「nszpc」）的內部介面：訂單「發布到官網」變成出機紀錄（backend/src/rpc.ts 的 WebsiteAPI）。
  // Worker 之間直接呼叫，不經過公開網址
  "services": [{ "binding": "WEBSITE", "service": "nszpc", "entrypoint": "WebsiteAPI" }],
  "r2_buckets": [
    {
      // 報價單圖片
      "binding": "UPLOADS",
      "bucket_name": "nszpc-dpom-uploads"
    }
  ],
  "observability": {
    "enabled": true
  }
}
